{
  "manifest_version": 3,
  "name": "AutoFill AI - Amazon & Flipkart Listings",
  "version": "1.7.0",
  "description": "Reads seller product forms, generates every field with AI and fills them in one click.",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open AutoFill AI"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "pagehook.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "engine.js",
        "watcher.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}